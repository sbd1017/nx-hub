{
  "Urls": "http://*:8080",
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "NxHub.Protocol": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": false,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "NxHub": {
    "DataDirectory": null,
    "Auth": {
      "Mode": "Token"
    },
    "Sessions": {
      "ConnectTimeoutSeconds": 5,
      "ResponseTimeoutSeconds": 3,
      "HeartbeatSeconds": 10,
      "ReconnectInitialSeconds": 1,
      "ReconnectMaxSeconds": 30,
      "MaxHoldSeconds": 30,
      "NeutraliseOnConnect": "OnlyIfHeld"
    }
  }
}
